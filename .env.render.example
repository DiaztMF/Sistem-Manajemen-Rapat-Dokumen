APP_NAME="SmartOffice Rapat & Dokumen"
APP_ENV=production
APP_KEY=base64:hM6VX9n4qH96ZGJXdDHAogSmkVIh1wnQ2Dio7+kDN1I=
APP_DEBUG=false
APP_URL=https://sistem-manajemen-rapat-dokumen.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database PostgreSQL Render (Gunakan Internal Database URL dari Render)
DB_CONNECTION=pgsql
# Masukkan nilai DB_URL berikut dari Internal Database URL dashboard Render:
DB_URL=postgresql://user:password@hostname:5432/dbname
DB_SSLMODE=require

# Alternatif jika menggunakan parameter terpisah:
# DB_HOST=dpg-xxxx-a.singapore-postgres.render.com
# DB_PORT=5432
# DB_DATABASE=sistem_rapat_prod
# DB_USERNAME=sistem_rapat_user
# DB_PASSWORD=your_secure_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local
